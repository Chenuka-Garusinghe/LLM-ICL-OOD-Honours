# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data / results / model artifacts (large, regenerable — not version controlled)
data/real/*
!data/real/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
data/tableshift_cache/
data/tableshift_raw_cache/
data/anes_timeseries_cdf_csv_*/
data/folktables_raw/
data/whyshift_raw_cache/
results/*
!results/.gitkeep
# Exception: the v2 collected results (~14 MB of per-row predictions) ARE
# version controlled. Notebooks 11-14 read them directly, and unlike the v1
# results they are not cheaply regenerable -- roughly 4 H200-hours of
# inference sits behind them.
!results/v2/
!results/v2/*.parquet
!results/v2/*.csv
figures/*
!figures/.gitkeep
tables/*
!tables/.gitkeep

# Exception: the v2 redesign's figures and summary tables ARE version
# controlled. They are small (1.2 MB of PNGs, 48 KB of CSVs) and, unlike the
# v1 outputs, not cheaply regenerable -- the GPU runs behind them cost ~4
# H200-hours. The raw per-row prediction parquets stay ignored under results/.
!figures/v2/
!tables/v2/
models/*
!models/.gitkeep

# OS
.DS_Store

# Fitted shift-estimation context cache (regenerable via scripts/prep_shift_context.py)
_screen_cache/
